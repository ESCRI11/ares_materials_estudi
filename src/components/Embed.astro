---
/**
 * An external interactive tool, framed and captioned: a Wokwi circuit, a p5.js
 * sketch, a Fusion 360 viewer. Only pass a URL you have actually opened — a
 * broken iframe is worse than a link.
 */
interface Props {
	src: string;
	title: string;
	height?: number;
	/** Where "open in a new tab" should go, if it differs from the embed URL. */
	href?: string;
}

// Wokwi splits its own frame into an editor, a diagram and a serial monitor, so
// it needs real height to be usable — 420 leaves three unreadable slivers.
const { src, title, height = 680, href = src } = Astro.props;
---

{/* The height goes through a custom property because Starlight's markdown CSS
    sets `iframe { height: auto }`, which beats the HTML height attribute and
    collapses the frame to ~150px. */}
<figure class="embed" style={`--embed-height: ${height}px`}>
	<iframe {src} {title} loading="lazy" allow="fullscreen"></iframe>
	<figcaption>
		<a {href} target="_blank" rel="noopener">Open “{title}” in a new tab →</a>
	</figcaption>
</figure>

<style>
	.embed {
		margin: 2rem 0;
	}

	.embed iframe {
		width: 100%;
		height: var(--embed-height, 680px);
		border: 1px solid var(--sl-color-gray-5);
		background: #fff;
	}

	.embed figcaption {
		margin-top: 0.5rem;
		font-size: var(--sl-text-sm);
	}
</style>
