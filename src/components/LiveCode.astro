---
/**
 * An editable HTML/CSS/JS snippet that runs in the page. The reader changes the
 * code and presses Run — the closest thing to the VS Code loop they will use in
 * ID102.01, without installing anything.
 *
 * The iframe is sandboxed to scripts only: no same-origin, so a snippet cannot
 * reach this page, its localStorage, or the network as us.
 */
interface Props {
	/** A complete HTML fragment. Include <style> and <script> tags as needed. */
	code: string;
	title?: string;
	height?: number;
}

const { code, title = 'Try it', height = 220 } = Astro.props;
---

<live-code data-height={height}>
	<p class="live-title">{title}</p>
	<textarea class="live-source" spellcheck="false" aria-label={`${title} — editable code`}
		>{code.trim()}</textarea
	>
	<div class="live-actions">
		<button type="button" data-run>Run</button>
		<button type="button" data-reset>Reset</button>
	</div>
	<iframe
		class="live-result"
		title={`${title} — result`}
		sandbox="allow-scripts"
		height={height}
		srcdoc={code.trim()}></iframe>
</live-code>

<script>
	customElements.define(
		'live-code',
		class extends HTMLElement {
			connectedCallback() {
				const source = this.querySelector('textarea') as HTMLTextAreaElement;
				const result = this.querySelector('iframe') as HTMLIFrameElement;
				const original = source.value;

				const run = () => {
					// Reassigning srcdoc re-runs the snippet from scratch.
					result.srcdoc = source.value;
				};

				this.querySelector('[data-run]')?.addEventListener('click', run);
				this.querySelector('[data-reset]')?.addEventListener('click', () => {
					source.value = original;
					run();
				});
				// Ctrl/Cmd+Enter is what every editor they will meet uses.
				source.addEventListener('keydown', (event) => {
					if (event.key === 'Enter' && (event.metaKey || event.ctrlKey)) {
						event.preventDefault();
						run();
					}
				});
			}
		},
	);
</script>

<style>
	live-code {
		display: block;
		margin: 2rem 0;
		border: 1px solid var(--sl-color-gray-5);
	}

	.live-title {
		margin: 0;
		padding: 0.4rem 0.7rem;
		background: var(--sl-color-white);
		color: var(--sl-color-black);
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-xs);
	}

	.live-source {
		display: block;
		width: 100%;
		min-height: 8rem;
		padding: 0.7rem;
		border: 0;
		border-bottom: 1px solid var(--sl-color-gray-5);
		background: var(--sl-color-bg);
		color: var(--sl-color-white);
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-xs);
		line-height: 1.6;
		resize: vertical;
	}

	.live-actions {
		display: flex;
		gap: 0.4rem;
		padding: 0.5rem 0.7rem;
		border-bottom: 1px solid var(--sl-color-gray-5);
	}

	.live-actions button {
		padding: 0.25rem 0.8rem;
		font: inherit;
		font-size: var(--sl-text-xs);
		color: inherit;
		background: transparent;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 0;
		cursor: pointer;
	}

	.live-actions button:hover {
		background: var(--ind-marker);
		border-color: var(--ind-marker);
		color: var(--ind-black);
	}

	.live-result {
		display: block;
		width: 100%;
		border: 0;
		background: #fff;
	}
</style>
