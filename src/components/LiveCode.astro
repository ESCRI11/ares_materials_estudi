---
/**
 * An editable HTML/CSS/JS snippet that runs in the page. The reader changes the
 * code and presses Run — the closest thing to the VS Code loop they will use in
 * ID102.01, without installing anything.
 *
 * The iframe is sandboxed to scripts only: no same-origin, so a snippet cannot
 * reach this page, its localStorage, or the network as us. That also means the
 * parent cannot measure the result's height directly, so a small bootstrap
 * script is appended to every snippet to post its height back.
 */
interface Props {
	/** A complete HTML fragment. Include <style> and <script> tags as needed. */
	code: string;
	title?: string;
	/** Starting height of the result panel. It then grows to fit its content. */
	height?: number;
}

const { code, title = 'Try it', height = 260 } = Astro.props;
---

{/* not-content opts every descendant out of Starlight's markdown spacing, which
    otherwise adds a top margin to any two adjacent siblings — including the Run
    and Reset buttons, which then sit at different heights. */}
<live-code class="not-content" data-height={height}>
	<p class="live-title">{title}</p>
	<div class="live-editor">
		<pre class="live-highlight" aria-hidden="true"><code></code></pre>
		<textarea class="live-source" spellcheck="false" aria-label={`${title} — editable code`}
			>{code.trim()}</textarea
		>
	</div>
	<div class="live-actions">
		<button type="button" data-run>Run</button>
		<button type="button" data-reset>Reset</button>
		<span class="live-hint">Ctrl + Enter</span>
	</div>
	{/* Height is inline, not an attribute: Starlight's markdown CSS sets
	    `iframe { height: auto }`, which beats the attribute. The script then
	    overwrites this inline value once the snippet reports its real height. */}
	<iframe
		class="live-result"
		title={`${title} — result`}
		sandbox="allow-scripts"
		style={`height: ${height}px`}></iframe>
</live-code>

<script>
	import Prism from 'prismjs';

	// Appended to every snippet so the result panel can size itself. The iframe has
	// an opaque origin, so postMessage is the only channel back to the page.
	//
	// Measure the BODY, not documentElement: documentElement.scrollHeight is never
	// smaller than the iframe's own viewport, so growing the iframe grows the
	// reported height, which grows the iframe — it runs away on the first frame.
	// Body height is content-driven, so it settles.
	const MEASURE = `<script>(function(){var last=0;function send(){var h=document.body.scrollHeight+16;if(Math.abs(h-last)<3)return;last=h;parent.postMessage({liveHeight:h},'*');}addEventListener('load',send);if(window.ResizeObserver)new ResizeObserver(send).observe(document.body);setTimeout(send,60);setTimeout(send,400);})();<\/script>`;

	customElements.define(
		'live-code',
		class extends HTMLElement {
			connectedCallback() {
				const source = this.querySelector('textarea') as HTMLTextAreaElement;
				const highlight = this.querySelector('.live-highlight code') as HTMLElement;
				const result = this.querySelector('iframe') as HTMLIFrameElement;
				const original = source.value;
				const minHeight = Number(this.dataset.height) || 260;

				// A trailing newline would otherwise collapse and misalign the last line.
				const paint = () => {
					highlight.innerHTML = Prism.highlight(
						source.value + '\n',
						Prism.languages.markup,
						'markup',
					);
				};

				const run = () => {
					// Reassigning srcdoc re-runs the snippet from scratch.
					result.srcdoc = source.value + MEASURE;
				};

				addEventListener('message', (event) => {
					if (event.source !== result.contentWindow) return;
					const wanted = (event.data as { liveHeight?: number })?.liveHeight;
					if (typeof wanted !== 'number') return;
					result.style.height = `${Math.min(Math.max(wanted + 8, minHeight), 900)}px`;
				});

				source.addEventListener('input', paint);
				source.addEventListener('scroll', () => {
					(highlight.parentElement as HTMLElement).scrollTop = source.scrollTop;
				});
				this.querySelector('[data-run]')?.addEventListener('click', run);
				this.querySelector('[data-reset]')?.addEventListener('click', () => {
					source.value = original;
					paint();
					run();
				});
				// Ctrl/Cmd+Enter is what every editor they will meet uses.
				source.addEventListener('keydown', (event) => {
					if (event.key === 'Enter' && (event.metaKey || event.ctrlKey)) {
						event.preventDefault();
						run();
					}
					// A real Tab should indent, not jump to the next control.
					if (event.key === 'Tab') {
						event.preventDefault();
						const { selectionStart: start, selectionEnd: end, value } = source;
						source.value = `${value.slice(0, start)}  ${value.slice(end)}`;
						source.selectionStart = source.selectionEnd = start + 2;
						paint();
					}
				});

				paint();
				run();
			}
		},
	);
</script>

<style>
	live-code {
		display: block;
		margin: 2rem 0;
		border: 1px solid var(--sl-color-gray-5);
	}

	.live-title {
		margin: 0;
		padding: 0.4rem 0.7rem;
		background: var(--sl-color-white);
		color: var(--sl-color-black);
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-xs);
	}

	/*
	 * The highlighted <pre> sits in normal flow and therefore sets the height, so
	 * the editor grows with the code instead of scrolling inside a fixed box. The
	 * textarea is laid over it, transparent, with only its caret visible — so the
	 * two must wrap identically or the text and its colours drift apart.
	 */
	.live-editor {
		position: relative;
		border-bottom: 1px solid var(--sl-color-gray-5);
	}

	.live-highlight,
	.live-source {
		margin: 0;
		padding: 0.8rem;
		border: 0;
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-sm);
		line-height: 1.65;
		tab-size: 2;
		white-space: pre-wrap;
		overflow-wrap: break-word;
		word-break: break-word;
	}

	.live-highlight {
		min-height: 7rem;
		background: var(--sl-color-bg);
		color: var(--sl-color-gray-2);
		overflow: visible;
	}

	.live-source {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		resize: none;
		overflow: hidden;
		background: transparent;
		color: transparent;
		caret-color: var(--sl-color-white);
	}

	.live-source::selection {
		background: var(--ind-marker);
		color: var(--ind-black);
	}

	.live-source:focus {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: -2px;
	}

	.live-actions {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.5rem 0.7rem;
		border-bottom: 1px solid var(--sl-color-gray-5);
	}

	.live-actions button {
		padding: 0.25rem 0.8rem;
		font: inherit;
		font-size: var(--sl-text-xs);
		color: inherit;
		background: transparent;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 0;
		cursor: pointer;
	}

	.live-actions button:hover {
		background: var(--ind-marker);
		border-color: var(--ind-marker);
		color: var(--ind-black);
	}

	.live-hint {
		margin-left: auto;
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}

	.live-result {
		display: block;
		width: 100%;
		border: 0;
		background: #fff;
		transition: height 0.15s ease;
	}
</style>
