---
interface Props {
	/** Embed URL from the p5.js editor: https://editor.p5js.org/<user>/embed/<sketchId> */
	src: string;
	title: string;
	height?: number;
}

const { src, title, height = 420 } = Astro.props;
---

<figure class="p5-embed">
	<iframe {src} {title} {height} loading="lazy" allow="fullscreen"></iframe>
	<figcaption>
		<a href={src.replace('/embed/', '/sketches/')} target="_blank" rel="noopener">
			Open “{title}” in the p5.js editor →
		</a>
	</figcaption>
</figure>

<style>
	.p5-embed {
		margin: 2rem 0;
	}

	.p5-embed iframe {
		width: 100%;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.75rem;
		background: white;
	}

	.p5-embed figcaption {
		margin-top: 0.5rem;
		font-size: var(--sl-text-sm);
	}
</style>
