---
interface Question {
	q: string;
	options: string[];
	/** Index into `options` of the correct answer. */
	answer: number;
	/** Shown after answering. A wrong answer must teach, so this is required. */
	explanation: string;
}

interface Props {
	questions: Question[];
	title?: string;
}

const { questions, title = 'Check yourself' } = Astro.props;

/*
 * Options are shuffled at build time, because written by hand they are not random:
 * across the site 80% of correct answers sat in the middle position, so the whole
 * quiz apparatus could be beaten at 80% by always clicking option two, without
 * reading a word.
 *
 * The shuffle is seeded from the question text rather than random, so a given
 * question always shuffles the same way. That keeps builds reproducible and means
 * a reader who returns to a page sees the order they remember.
 */
const seeded = (text: string) => {
	let h = 2166136261;
	for (const ch of text) h = Math.imul(h ^ ch.charCodeAt(0), 16777619);
	return () => {
		h = Math.imul(h ^ (h >>> 15), 2246822507);
		return ((h ^= h >>> 13) >>> 0) / 4294967296;
	};
};

const shuffled = questions.map((question) => {
	const rand = seeded(question.q);
	const order = question.options.map((option, i) => ({ option, i }));
	for (let i = order.length - 1; i > 0; i--) {
		const j = Math.floor(rand() * (i + 1));
		[order[i], order[j]] = [order[j], order[i]];
	}
	return {
		...question,
		options: order.map((o) => o.option),
		answer: order.findIndex((o) => o.i === question.answer),
	};
});

// One key for the whole block rather than a data-correct on every button: the site
// teaches readers to open the element inspector, and a true/false sitting on each
// option turns that lesson into a way to cheat this one.
const key = Buffer.from(shuffled.map((q) => q.answer).join(',')).toString('base64');
---

{/* not-content keeps Starlight's markdown spacing out of the option list — it
    adds a top margin between adjacent siblings, which fights the flex gap. */}
<quiz-block class="not-content" data-total={shuffled.length} data-k={key}>
	<h3 class="quiz-title">{title}</h3>
	{
		shuffled.map((question) => (
			<div class="quiz-q">
				<p class="quiz-prompt">{question.q}</p>
				<div class="quiz-options">
					{question.options.map((option) => (
						<button type="button" class="quiz-option">
							{option}
						</button>
					))}
				</div>
				<p class="quiz-explanation" hidden>
					{question.explanation}
				</p>
			</div>
		))
	}
	<p class="quiz-score" hidden></p>
</quiz-block>

<script>
	customElements.define(
		'quiz-block',
		class extends HTMLElement {
			connectedCallback() {
				const total = Number(this.dataset.total);
				const score = this.querySelector('.quiz-score') as HTMLElement;
				const answers = atob(this.dataset.k ?? '')
					.split(',')
					.map(Number);
				let answered = 0;
				let correct = 0;

				this.querySelectorAll<HTMLElement>('.quiz-q').forEach((question, qi) => {
					question.addEventListener('click', (event) => {
						const picked = (event.target as HTMLElement).closest('.quiz-option');
						if (!picked || question.dataset.done) return;

						question.dataset.done = 'true';
						const options = [...question.querySelectorAll('.quiz-option')];
						const isRight = options.indexOf(picked) === answers[qi];
						picked.classList.add(isRight ? 'is-correct' : 'is-wrong');
						if (!isRight) {
							options[answers[qi]]?.classList.add('is-correct');
						}
						(question.querySelector('.quiz-explanation') as HTMLElement).hidden = false;

						answered++;
						if (isRight) correct++;
						if (answered === total) {
							score.hidden = false;
							score.textContent = `${correct} of ${total} correct.`;
						}
					});
				});
			}
		},
	);
</script>

<style>
	quiz-block {
		display: block;
		margin: 2.5rem 0;
		padding: 1.25rem 0 0;
		border-top: 2px solid var(--sl-color-white);
	}

	quiz-block h3 {
		margin: 0 0 1.25rem;
	}

	.quiz-q + .quiz-q {
		margin-top: 1.75rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--sl-color-gray-5);
	}

	.quiz-prompt {
		margin: 0 0 0.75rem;
		font-weight: 600;
	}

	.quiz-options {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.quiz-option {
		padding: 0.55rem 0.75rem;
		text-align: left;
		font: inherit;
		color: inherit;
		background: transparent;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0;
		cursor: pointer;
	}

	.quiz-option:hover {
		border-color: var(--sl-color-white);
	}

	.quiz-q[data-done] .quiz-option {
		cursor: default;
		pointer-events: none;
		opacity: 0.5;
	}

	/* Answers are marked with the brand's highlighter fills, black text on top. */
	.quiz-q[data-done] .is-correct,
	.quiz-q[data-done] .is-wrong {
		opacity: 1;
		color: var(--ind-black);
		border-color: transparent;
	}

	.is-correct {
		background: var(--ind-highlight-green);
	}

	.is-wrong {
		background: var(--ind-highlight-red);
	}

	.quiz-explanation {
		margin: 0.75rem 0 0;
		padding-left: 0.9rem;
		border-left: 1px solid var(--sl-color-gray-4);
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}

	/* :not([hidden]) matters — a bare `display` would override the hidden attribute
	   and leave an empty marker chip sitting under every quiz. */
	.quiz-score:not([hidden]) {
		margin: 1.75rem 0 0;
		display: inline-block;
		padding: 0.1em 0.3em;
		background: var(--ind-marker);
		color: var(--ind-black);
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-sm);
	}
</style>
