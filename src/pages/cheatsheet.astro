/*
 * The printed reference card. This is a plain Astro page, NOT a Starlight one, so it
 * arrives with no header, sidebar or table of contents to fight — which is what makes it
 * printable. scripts/make-cheatsheet.mjs renders this exact page to dist/cheatsheet.pdf.
 *
 * Pagination is data, not flow: each entry of SHEETS is one printed side. To move a block
 * to the other side, move it between the arrays. The build asserts nothing overflows.
 *
 * Every block carries the slug of the lesson it came from and renders as a link, so
 * scripts/check-links.mjs fails the build if that lesson is ever renamed or deleted. That
 * is the whole drift guard — keep the links.
 */
import '../styles/custom.css';

/** [code, meaning] — or [code, meaning, 'warn'] to mark it with the highlighter. */
