---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Cheatsheet — InD Prep</title>
		<meta
			name="description"
			content="A two-page printable reference card for the technical material of the MA SUPSI in Interaction Design."
		/>
		{/* Self-hosted on purpose. Loading these from a CDN worked here and silently failed
		    on the CI runner, which fell back to Liberation Sans and embedded the wrong
		    typeface in the PDF — with no failed request to catch it. Arimo is Arial-metric,
		    which is the fallback the site itself names; Plex Mono Medium is the face the
		    syllabus embeds. See public/fonts/README.md for licences. */}
		<style is:inline>
			@font-face {
				font-family: 'Arimo';
				src: url('/ares_materials_estudi/fonts/arimo.woff2') format('woff2');
				font-weight: 400 700;
				font-display: block;
			}
			@font-face {
				font-family: 'IBM Plex Mono';
				src: url('/ares_materials_estudi/fonts/plexmono-400.woff2') format('woff2');
				font-weight: 400;
				font-display: block;
			}
			@font-face {
				font-family: 'IBM Plex Mono';
				src: url('/ares_materials_estudi/fonts/plexmono-500.woff2') format('woff2');
				font-weight: 500;
				font-display: block;
			}
		</style>
	</head>
	<body>
		<p class="screen-only">
			Two pages, made to be printed double-sided on one A4 sheet.
			{/* check-links.mjs has no `pdf` in its ASSET regex, so it validates this as a page —
			    meaning the build fails if the PDF is missing. Do not "fix" that regex. */}
			<a href="/ares_materials_estudi/cheatsheet.pdf">Download the PDF</a>, or print this page
			directly. <a href="/ares_materials_estudi/">Back to the site</a>.
		</p>

		{
			SHEETS.map((blocks, sheet) => (
				<section class="sheet">
					<span class="mark tl" /><span class="mark tr" />
					<span class="mark bl" /><span class="mark br" />

					{sheet === 0 && (
						<header class="masthead">
							<h1>Interaction Design — technical cheatsheet</h1>
							<p>
								Everything on this card is taught in full at
								escri11.github.io/ares_materials_estudi
							</p>
						</header>
					)}

					<div class="cols">
						{blocks.map((block) => (
							<div class="block" data-section={block.slug.split('/')[0]}>
								<h2>
									<a href={`/ares_materials_estudi/${block.slug}/`}>{block.title}</a>
								</h2>
								<dl>
									{block.rows.map(([code, meaning, flag]) => (
										<div class:list={['row', flag]}>
											<dt>{code}</dt>
											<dd>{meaning}</dd>
										</div>
									))}
								</dl>
							</div>
						))}
					</div>

					<span class="folio">p.{String(sheet + 1).padStart(2, '0')}</span>
				</section>
			))
		}
	</body>
</html>

<style is:global>
	@page {
		size: A4;
		margin: 0;
	}

	html,
	body {
		margin: 0;
		padding: 0;
		background: #d8d8d8;
	}

	.screen-only {
		max-width: 210mm;
		margin: 0 auto;
		padding: 1rem 12mm;
		font-family: Arimo, Arial, sans-serif;
		font-size: 0.9rem;
	}

	/*
	 * A fixed-size sheet rather than flowed pagination: a page break can then only ever
	 * fall between sheets, so a block physically cannot be split across pages.
	 * 296.8mm, not 297 — at exactly 297 Chromium rounds up and emits a blank trailing page.
	 */
	.sheet {
		position: relative;
		width: 210mm;
		height: 296.8mm;
		box-sizing: border-box;
		padding: 13mm 11mm 15mm;
		margin: 0 auto 8mm;
		background: #fff;
		color: var(--ind-black);
		font-family: Arimo, Arial, sans-serif;
		font-size: 8pt;
		line-height: 1.32;
		break-after: page;
		print-color-adjust: exact;
		-webkit-print-color-adjust: exact;
	}

	.sheet:last-of-type {
		break-after: auto;
	}

	.masthead {
		margin: 0 0 3mm;
		padding-bottom: 2mm;
		border-bottom: 0.4pt solid var(--ind-black);
	}

	.masthead h1 {
		margin: 0;
		font-size: 13pt;
		font-weight: 700;
		letter-spacing: -0.01em;
	}

	.masthead p {
		margin: 0.6mm 0 0;
		font-family: 'IBM Plex Mono', monospace;
		font-size: 6pt;
		color: #555;
	}

	.cols {
		columns: 3;
		column-gap: 5mm;
		column-rule: 0.25pt solid var(--ind-light-gray);
	}

	.block {
		break-inside: avoid;
		margin: 0 0 3.4mm;
	}

	/* The syllabus's signature device: a tight inverted block behind a short label. */
	.block h2 {
		display: inline-block;
		margin: 0 0 1.2mm;
		padding: 0.4mm 1.2mm;
		background: var(--ind-black);
		font-family: 'IBM Plex Mono', monospace;
		font-size: 6.9pt;
		font-weight: 500;
		letter-spacing: 0.02em;
	}

	.block h2 a {
		color: #fff;
		text-decoration: none;
	}

	dl {
		margin: 0;
	}

	.row {
		display: flex;
		gap: 1.5mm;
		padding: 0.35mm 0;
		align-items: baseline;
	}

	dt {
		flex: 0 0 auto;
		max-width: 62%;
		font-family: 'IBM Plex Mono', monospace;
		font-size: 7pt;
		font-weight: 500;
		overflow-wrap: anywhere;
	}

	dd {
		flex: 1;
		margin: 0;
		color: #333;
	}

	/* The only colour on the card. Reserved for things that cost you real time. */
	.row.warn dd {
		background: var(--ind-marker);
		color: var(--ind-black);
		padding: 0 0.8mm;
	}

	.folio {
		position: absolute;
		right: 11mm;
		bottom: 8mm;
		padding: 0.4mm 1.2mm;
		background: var(--ind-black);
		color: #fff;
		font-family: 'IBM Plex Mono', monospace;
		font-size: 6.4pt;
		font-weight: 500;
	}

	/* Inset from the trim, not on it — home print dialogues shrink a margin-0 A4. */
	.mark {
		position: absolute;
		width: 3mm;
		height: 3mm;
	}
	.mark.tl {
		top: 6mm;
		left: 6mm;
		border-top: 0.25pt solid #999;
		border-left: 0.25pt solid #999;
	}
	.mark.tr {
		top: 6mm;
		right: 6mm;
		border-top: 0.25pt solid #999;
		border-right: 0.25pt solid #999;
	}
	.mark.bl {
		bottom: 6mm;
		left: 6mm;
		border-bottom: 0.25pt solid #999;
		border-left: 0.25pt solid #999;
	}
	.mark.br {
		bottom: 6mm;
		right: 6mm;
		border-bottom: 0.25pt solid #999;
		border-right: 0.25pt solid #999;
	}

	@media print {
		html,
		body {
			background: #fff;
		}
		.screen-only {
			display: none;
		}
		.sheet {
			margin: 0;
		}
	}
</style>
